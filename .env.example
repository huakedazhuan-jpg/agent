# Local development environment template.
# Copy this file to .env and fill in real values locally.
# Never commit real secrets.

# OpenAI-compatible chat model provider. Moonshot/Kimi is the current default adapter.
MOONSHOT_API_KEY=
MOONSHOT_BASE_URL=https://api.moonshot.ai
MOONSHOT_MODEL=kimi-k2.5
MOONSHOT_TEMPERATURE=1
MOONSHOT_MAX_TOKENS=16000

# Direct Kimi tool-calling runtime settings.
AGENT_KIMI_REQUEST_TIMEOUT=60s
AGENT_KIMI_MAX_TOOL_ROUNDS=5
AGENT_KIMI_HISTORY_LIMIT=20

# Feishu integration. Required only when enabling Feishu webhook/reply flows.
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=
FEISHU_ASYNC_CORE_SIZE=2
FEISHU_ASYNC_MAX_SIZE=4
FEISHU_ASYNC_QUEUE_CAPACITY=100

# Tavily search integration. Required only when enabling Tavily-backed search.
TAVILY_API_KEY=

# Local persistence files used by the prototype storage adapters.
AGENT_MEMORY_FILE=data/chat-memory.jsonl
AGENT_RAG_INDEX_FILE=data/rag-index.json

# Local tool workspace. Keep this inside the project or another explicitly controlled directory.
AGENT_WORKSPACE_ROOT=./workspace
